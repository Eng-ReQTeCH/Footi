# Copy to .env and change these before deploying
POSTGRES_PASSWORD=footi
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too
APP_PORT=1234

# Player pool filters (optional). PLAYER_MV_FLOOR is the min highest market value (EUR) for outfield
# players; PLAYER_GK_MV_FLOOR applies to goalkeepers; PLAYER_FC_RATING_FLOOR is the FC26 overall rating
# floor; top-club players get TOP_CLUB_MV_FLOOR. Players passing any floor are kept, plus Egyptians.
PLAYER_MV_FLOOR=40000000
PLAYER_GK_MV_FLOOR=15000000
TOP_CLUB_MV_FLOOR=18000000
PLAYER_FC_RATING_FLOOR=83
