# Copy to .env and change these before deploying
POSTGRES_PASSWORD=footi
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_TOKEN=change-me-too
APP_PORT=1234

# Player pool filters (optional). Standard pool uses per-position MV floors (EUR):
# PLAYER_DEF_MV_FLOOR / PLAYER_MID_MV_FLOOR / PLAYER_ATT_MV_FLOOR; PLAYER_GK_MV_FLOOR
# applies to goalkeepers; PLAYER_FC_RATING_FLOOR is the FC26 overall rating floor;
# top-club players get TOP_CLUB_MV_FLOOR. Players passing any floor are kept, plus Egyptians.
PLAYER_DEF_MV_FLOOR=45000000
PLAYER_MID_MV_FLOOR=55000000
PLAYER_ATT_MV_FLOOR=65000000
PLAYER_GK_MV_FLOOR=25000000
TOP_CLUB_MV_FLOOR=40000000
PLAYER_FC_RATING_FLOOR=84

# Guess Who uses a stricter, star-only pool. Higher per-position MV floors and an 86+ FC rating.
GUESS_TOP_CLUB_MV_FLOOR=50000000
GUESS_GK_MV_FLOOR=40000000
GUESS_DEF_MV_FLOOR=70000000
GUESS_MID_MV_FLOOR=80000000
GUESS_ATT_MV_FLOOR=90000000
GUESS_FC_RATING_FLOOR=86
